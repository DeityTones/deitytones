# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never put real keys in this file or anywhere in the repository.

# Restricted key from Stripe (starts with rk_test_ while testing, rk_live_ when live)
STRIPE_SECRET_KEY=

# Signing secret for the webhook destination (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Set to "on" only after adding a tax registration in Stripe
STRIPE_AUTOMATIC_TAX=off

# "Make a copy" link for each template, shown after payment
TEMPLATE_URL_ARTIST_PORTAL_SHEET=
